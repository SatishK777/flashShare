# ====================================
# FlashShare Environment Variables
# ====================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ── Database ──────────────────────────
DATABASE_URL=postgresql://flashshare:flashshare_secret@localhost:5432/flashshare

# ── Redis ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Storage (MinIO for dev) ───────────
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=flashshare
STORAGE_REGION=us-east-1

# ── Server ────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ── Security ──────────────────────────
SIGNED_URL_SECRET=change-me-to-a-random-64-char-string
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ADMIN_TOKEN=change-me-to-a-secure-admin-token

# ── WebRTC ────────────────────────────
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# ── Frontend (Vite .env) ─────────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
VITE_APP_URL=http://localhost:5173
